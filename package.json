{
  "name": "tcp-worker-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && tsc -p tsconfig.web.json && vite build",
    "start": "node dist/server/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && npm run test:frontend && node --test dist/server/test/*.test.js",
    "demo": "npm run build:server && node dist/server/demo.js",
    "test:unit": "npm run build:server && node --test dist/server/test/unit.test.js dist/server/test/live-unit.test.js && npm run test:frontend",
    "client": "node dist/server/cli.js",
    "verify": "node scripts/verify.mjs",
    "test:frontend": "tsc -p tsconfig.ui-tests.json && node --test dist/ui/web/*.test.js"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "@types/ws": "8.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
